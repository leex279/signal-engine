# OpenRouter API Key (used for Jev decision pass and LLM reading pass)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: GitHub Personal Access Token (increases GitHub API rate limit from 60/hr to 5000/hr)
GITHUB_TOKEN=

# Optional: Override models
DECISION_MODEL=typesafe/jev-1.13
DECISION_FALLBACK_MODEL=google/gemini-2.5-flash-lite
READING_MODEL=anthropic/claude-sonnet-4.5
